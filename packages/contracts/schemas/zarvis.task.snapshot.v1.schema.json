{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zeaz.dev/zarvis/task-snapshot.v1.schema.json",
  "title": "ZARVIS Task Snapshot v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_version",
    "id",
    "tenant_id",
    "owner_user_id",
    "objective",
    "plan",
    "status",
    "approval_state",
    "approval_digest",
    "approval_expires_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_version": { "const": "zarvis.task.v1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "const": "owner-4076926" },
    "owner_user_id": { "const": "github:4076926" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": {
      "enum": ["pending_approval", "paused", "approved", "running", "succeeded", "failed", "cancelled", "expired"]
    },
    "approval_state": { "enum": ["pending", "approved"] },
    "approval_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_nonce": { "type": ["string", "null"] },
    "approval_expires_at": { "type": "string", "format": "date-time" },
    "approval_consumed_at": { "type": "string", "format": "date-time" },
    "plan": {
      "type": "object",
      "required": ["objective", "steps"],
      "properties": {
        "objective": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 20 }
      }
    },
    "step_results": { "type": "array" },
    "checkpoint": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
