{
  "name": "@z-platform/zeaz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full-stack bilingual ZEAZ One website for www.zeaz.dev",
  "scripts": {
    "build": "node scripts/validate-build.mjs",
    "lint": "node --check src/index.js && node --check scripts/render-wrangler.mjs",
    "typecheck": "node --check src/index.js",
    "test": "node --test test/*.test.mjs",
    "dev": "pnpm dlx wrangler@4.114.0 dev --config wrangler.local.jsonc",
    "deploy": "pnpm dlx wrangler@4.114.0 deploy --config wrangler.generated.jsonc"
  },
  "engines": { "node": ">=22.13", "pnpm": ">=11" }
}
