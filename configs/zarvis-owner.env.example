# Z.A.R.V.I.S. is permanently bound in source code to GitHub user ID 4076926.
# There is intentionally no environment variable that can change the owner.

# Generate the values independently with a cryptographically secure random generator.
# Edge and orchestrator secrets must each contain at least 32 bytes.
ZARVIS_EDGE_SHARED_SECRET=replace-with-at-least-32-random-bytes
ZARVIS_ORCHESTRATOR_SERVICE_TOKEN=replace-with-another-32-byte-random-token

# Durable owner session and idempotency state.
ZARVIS_DATA_DIR=/var/lib/zarvis
ZARVIS_ORCHESTRATOR_URL=http://127.0.0.1:8094
ZARVIS_GITHUB_TIMEOUT_MS=5000

# Reuse the existing realtime voice stack as the owner-only command surface.
ZVOICE_ZARVIS_MODE=true
ZVOICE_ALLOW_ANONYMOUS=false
Z_PLATFORM_VOICE_GATEWAY_URL=http://127.0.0.1:8450
Z_PLATFORM_SERVICE_TOKEN=replace-with-voice-gateway-service-token
