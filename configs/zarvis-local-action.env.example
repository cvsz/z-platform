# Z.A.R.V.I.S. Local Action Gateway
# Copy to .env.zarvis.local and keep permissions at 0600.
# Generate each token independently with: openssl rand -hex 32

ZARVIS_ACTION_PORT=8098
ZARVIS_ACTION_WORKER_INTERVAL_MS=1000
ZARVIS_LOCAL_OWNER_TOKEN=replace-with-independent-64-character-hex-token
ZARVIS_ACTION_WORKER_TOKEN=replace-with-another-independent-64-character-hex-token
