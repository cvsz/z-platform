# Z.A.R.V.I.S. local-only stack
# Copy to .env.zarvis.local, generate every secret independently, and chmod 0600.

ZARVIS_ACTION_PORT=8098
ZARVIS_ACTION_WORKER_INTERVAL_MS=1000
ZARVIS_PROACTIVE_PORT=8099
ZARVIS_PROACTIVE_WORKER_INTERVAL_MS=60000
ZARVIS_PROACTIVE_CHECK_TIMEOUT_MS=3000

# Generate each with: openssl rand -hex 32
ZARVIS_LOCAL_OWNER_TOKEN=replace-with-independent-64-character-hex-token
ZARVIS_ACTION_WORKER_TOKEN=replace-with-independent-action-worker-token
ZARVIS_PROACTIVE_WORKER_TOKEN=replace-with-independent-proactive-worker-token

# Must remain an allowlisted loopback HTTP /healthz endpoint.
ZARVIS_ACTION_HEALTH_URL=http://127.0.0.1:8098/healthz
